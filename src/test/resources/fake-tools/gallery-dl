#!/usr/bin/env python3
import json
import os
import sys

args = sys.argv[1:]
here = os.path.dirname(os.path.abspath(__file__))
log_path = os.path.join(here, "calls.log")

with open(log_path, "a") as log:
    log.write(json.dumps(args) + "\n")

if "--version" in args:
    print("1.28.0")
    sys.exit(0)

target = args[-1] if args else ""
if "private" in target:
    sys.stderr.write("ERROR: [twitter] 401 Unauthorized / Private account\n")
    sys.exit(1)

out_dir = "."
for i, a in enumerate(args):
    if a == "-d" and i + 1 < len(args):
        out_dir = args[i + 1]

os.makedirs(out_dir, exist_ok=True)
with open(os.path.join(out_dir, "gallery_photo.jpg"), "wb") as f:
    f.write(b"\0" * 1024)

sys.exit(0)
